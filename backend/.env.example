PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace_with_a_secure_jwt_secret_key_2026

# Nodemailer SMTP Configuration (Optional: leave SMTP_USER blank to print OTP to terminal)
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Smart BUP Cafeteria" <no-reply@bup.edu.bd>

# PostgreSQL Configuration (Optional: Hybrid In-Memory Relational mode runs automatically)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=sbcms_db
PG_USER=postgres
PG_PASSWORD=postgres
